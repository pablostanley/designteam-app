{
  "name": "@designteam/adapter-claude-cli",
  "version": "0.1.0",
  "description": "Design Team adapter that dispatches each task to the local `claude` CLI. Builds a prompt from agent personality + team memory + user profile + task brief, captures stdout as the deliverable.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@designteam/adapter-utils": "workspace:*",
    "@designteam/core": "workspace:*"
  }
}
